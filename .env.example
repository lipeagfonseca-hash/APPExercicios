# Modelo das variáveis de ambiente. NUNCA coloque valores reais aqui.
# Os valores reais ficam no .env.local (ignorado pelo git) e na Vercel.

# Banco Postgres (Neon)
DATABASE_URL=

# Auth.js
AUTH_SECRET=

# Redis (Upstash) — rate limit
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — imagens da identidade visual
BLOB_READ_WRITE_TOKEN=

# Emails de administradores, separados por vírgula
ADMIN_EMAILS=
